{
  "name": "daoyuan-feature-frontend",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5178",
    "build": "./node_modules/.bin/vite build",
    "typecheck": "./node_modules/.bin/vue-tsc --noEmit",
    "test:fixtures": "node scripts/validate-fixtures.mjs",
    "test:trends-ui": "node scripts/validate-trends-ui.mjs",
    "test:forum-news-ui": "node scripts/validate-forum-news-ui.mjs",
    "test:v08": "node scripts/validate-v08-regressions.mjs",
    "test:spirit-stones": "node --experimental-strip-types scripts/validate-spirit-stones.mjs",
    "test:wanbao-transactions": "node --experimental-strip-types scripts/validate-wanbao-transactions.mjs",
    "test:wanbao-pricing": "node scripts/validate-wanbao-pricing.mjs",
    "test:prompt-injection": "node --experimental-strip-types scripts/validate-prompt-injection.mjs",
    "test:content-package": "node --experimental-strip-types scripts/validate-content-package.mjs",
    "test:user-scripts": "node --experimental-strip-types scripts/validate-user-script-runtime.mjs && node scripts/validate-content-injection.mjs",
    "build:earth-worldbook": "node scripts/build-earth-worldbook-seed.mjs",
    "build:xuantian-worldbook": "node ../玄天界推演规则书/生成世界书.mjs",
    "test:earth-worldbook": "node --experimental-strip-types scripts/validate-earth-worldbook.mjs",
    "test:earth-worldbook-manager": "node --experimental-strip-types scripts/validate-earth-worldbook-manager.mjs",
    "test:earth-simulation": "node --experimental-strip-types scripts/validate-earth-simulation.mjs",
    "test:xuantian-simulation": "node --experimental-strip-types scripts/validate-xuantian-simulation.mjs",
    "test:xuantian-worldbook": "node --experimental-strip-types scripts/validate-xuantian-worldbook.mjs",
    "test:world-simulation-core": "node --experimental-strip-types scripts/validate-world-simulation-core.mjs",
    "test:earth-runtime": "node --experimental-strip-types scripts/validate-earth-runtime.mjs",
    "test:earth-ui": "node scripts/validate-earth-ui-state.mjs",
    "package:candidate": "node scripts/package-candidate.mjs",
    "package:v11-test": "node scripts/package-candidate.mjs --v11-test",
    "package:v12-test": "node scripts/package-candidate.mjs --v12-test",
    "package:v12-cdn": "node scripts/package-cdn-external.mjs",
    "package:formal": "node scripts/package-candidate.mjs --formal",
    "check": "pnpm typecheck && pnpm test:fixtures && pnpm test:spirit-stones && pnpm test:wanbao-transactions && pnpm test:wanbao-pricing && pnpm test:prompt-injection && pnpm test:content-package && pnpm test:user-scripts && pnpm test:earth-worldbook && pnpm test:earth-worldbook-manager && pnpm test:world-simulation-core && pnpm test:earth-simulation && pnpm test:xuantian-worldbook && pnpm test:xuantian-simulation && pnpm test:trends-ui && pnpm test:forum-news-ui && pnpm test:v08 && pnpm build && pnpm package:v12-test"
  },
  "dependencies": {
    "vue": "^3.5.34",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.1",
    "typescript": "^5.9.3",
    "vite": "^7.1.3",
    "vue-tsc": "^3.0.6"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
